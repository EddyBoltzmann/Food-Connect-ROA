{
  "name": "food-connect",
  "version": "1.0.0",
  "description": "Cross-platform Restaurant Ordering Application",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace FoodConnect.xcworkspace -scheme FoodConnect -configuration Release -destination generic/platform=iOS -archivePath FoodConnect.xcarchive archive"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-reanimated": "^3.5.4",
    "react-native-vector-icons": "^10.0.2",
    "lottie-react-native": "^6.4.1",
    "styled-components": "^6.1.1",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.7.4",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-camera": "^4.2.1",
    "expo-barcode-scanner": "~12.6.2",
    "@stripe/stripe-react-native": "^0.35.0",
    "react-native-image-picker": "^7.0.3",
    "react-native-permissions": "^3.10.1",
    "react-native-keychain": "^8.1.3",
    "react-native-async-storage": "^1.19.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-svg": "^13.14.0",
    "react-native-modal": "^13.0.1",
    "react-native-super-grid": "^4.9.6",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-toast-message": "^2.1.6",
    "react-native-flash-message": "^0.4.2",
    "react-native-device-info": "^10.11.0",
    "react-native-localize": "^3.0.4",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4",
    "@types/styled-components-react-native": "^5.2.5",
    "detox": "^20.12.0"
  },
  "engines": {
    "node": ">=16"
  }
}